# Normalização de fim de linha — scripts shell e arquivos de infra DEVEM ser LF
# (rodam em Ubuntu: CI do GitHub Actions e VPS de staging).
* text=auto
*.sh text eol=lf
Caddyfile text eol=lf
Dockerfile text eol=lf
*.Dockerfile text eol=lf
*.dockerignore text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.ps1 text eol=crlf
*.cmd text eol=crlf
*.bat text eol=crlf
