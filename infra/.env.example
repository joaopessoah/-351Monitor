# =============================================================================
# +351 Monitor — exemplo de variáveis de ambiente do STAGING
# Copie para infra/.env na VPS e preencha. JAMAIS commitar o .env real
# (já está no .gitignore). JAMAIS colocar valores reais neste .env.example.
# =============================================================================

# --- Caddy / TLS -------------------------------------------------------------
# Domínio público do staging (DNS A apontando para a VPS Hostinger em São Paulo)
STAGING_DOMAIN=staging.SEU-DOMINIO.com.br
# E-mail para registro ACME (Let's Encrypt)
ACME_EMAIL=ops@SEU-DOMINIO.com.br

# --- PostgreSQL (container no staging — adaptação declarada) ------------------
POSTGRES_DB=m351_staging
POSTGRES_USER=m351
# Gere uma senha forte, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA

# --- Auth (JWT do portal) ------------------------------------------------------
# Chave HS256 de 256 bits, ex.: openssl rand -base64 32
JWT_SIGNING_KEY=TROQUE-ESTA-CHAVE-256-BITS
# Chave AES-GCM (32 bytes base64) que cifra os segredos TOTP: openssl rand -base64 32
MFA_ENCRYPTION_KEY=TROQUE-ESTA-CHAVE-AES-32-BYTES

# --- E-mail (SMTP para convites) -------------------------------------------------
# "Smtp" quando houver servidor de e-mail; "Dev" grava os e-mails como .txt
# dentro do container da api (docker compose exec api ls .dev-mail)
EMAIL_PROVIDER=Smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=nao-responda@SEU-DOMINIO.com.br

# --- Observabilidade -----------------------------------------------------------
# DSN do projeto no Sentry (vazio = Sentry desativado)
SENTRY_DSN=
# Hash da senha admin do Seq (primeira execução):
#   echo 'SuaSenha' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# --- Backup off-site cifrado (infra/scripts/backup.sh) -------------------------
# Destino da cópia fria do pg_dump. OBRIGATÓRIO: bucket em REGIÃO BRASILEIRA
# (S3 sa-east-1, Azure Brazil South ou Magalu Object Storage), com object lock
# e cifra em repouso. O provedor escolhido entra na lista de subprocessadores.
# Checklist de provisionamento: docs/runbooks/backup-restore.md
#
# Remote "crypt" do rclone: cifra o dump AINDA NA VPS, antes de sair.
# É a forma preferida e tem precedência sobre o remote puro abaixo. Guarde a
# senha do crypt no cofre: sem ela não existe restore.
#   rclone config -> tipo "crypt" -> remote base = o bucket BR
OFFSITE_CRYPT_REMOTE=
# Remote rclone puro (sem crypt). Só use se a cifra ficar por conta do bucket.
OFFSITE_RCLONE_REMOTE=
# Declare "sim" APENAS depois de conferir no console do provedor que a cifra em
# repouso (SSE-S3, SSE-KMS ou Azure SSE) está ativa no bucket de destino.
# Sem crypt e sem este "sim", o backup.sh emite aviso grave no log e continua.
OFFSITE_SSE_CONFIRMADO=
# Retenção remota em dias. Teto do DPA: 35 dias. Padrão: 30.
OFFSITE_RETENTION_DAYS=30
