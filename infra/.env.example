# =============================================================================
# +351 Monitor — exemplo de variáveis de ambiente do STAGING
# Copie para infra/.env na VPS e preencha. JAMAIS commitar o .env real
# (já está no .gitignore). JAMAIS colocar valores reais neste .env.example.
# =============================================================================

# --- Caddy / TLS -------------------------------------------------------------
# Domínio público do staging (DNS A apontando para a VPS Hostinger em São Paulo)
STAGING_DOMAIN=staging.SEU-DOMINIO.com.br
# E-mail para registro ACME (Let's Encrypt)
ACME_EMAIL=ops@SEU-DOMINIO.com.br

# --- PostgreSQL (container no staging — adaptação declarada) ------------------
POSTGRES_DB=m351_staging
POSTGRES_USER=m351
# Gere uma senha forte, ex.: openssl rand -base64 24
POSTGRES_PASSWORD=TROQUE-ESTA-SENHA

# --- Auth (JWT do portal) ------------------------------------------------------
# Chave HS256 de 256 bits, ex.: openssl rand -base64 32
JWT_SIGNING_KEY=TROQUE-ESTA-CHAVE-256-BITS
# Chave AES-GCM (32 bytes base64) que cifra os segredos TOTP: openssl rand -base64 32
MFA_ENCRYPTION_KEY=TROQUE-ESTA-CHAVE-AES-32-BYTES

# --- E-mail (SMTP para convites) -------------------------------------------------
# "Smtp" quando houver servidor de e-mail; "Dev" grava os e-mails como .txt
# dentro do container da api (docker compose exec api ls .dev-mail)
EMAIL_PROVIDER=Smtp
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=nao-responda@SEU-DOMINIO.com.br

# --- Backup off-site (rclone) ----------------------------------------------------
# Sem estas variáveis o backup.sh só gera o dump LOCAL (mesmo disco da VPS) e loga
# um aviso. Com elas, o dump do dia é copiado e validado num object storage remoto.
# ATENÇÃO residência BR: o bucket DEVE ficar em região brasileira (S3 sa-east-1,
# Azure Brazil South ou Magalu Cloud), NUNCA fora do Brasil, compromisso público
# do produto. Retenção remota: 30 dias, dentro do teto de 35 dias do DPA.
# Remoto rclone de destino (formato remoto:bucket), ex.: m351offsite:m351-backups
#OFFSITE_RCLONE_REMOTE=m351offsite:m351-backups
# Caminho do rclone.conf com as credenciais do remoto (fora do repo, acesso restrito)
#RCLONE_CONFIG=/etc/m351/rclone.conf
# Dias de retenção dos dumps no remoto (manter <= 35, teto do DPA)
#OFFSITE_RETENTION_DAYS=30
# Check do healthchecks.io do BACKUP: pingado SÓ após dump + off-site com sucesso
#HEALTHCHECKS_BACKUP_URL=https://hc-ping.com/SEU-UUID-BACKUP

# --- Observabilidade -----------------------------------------------------------
# DSN do projeto no Sentry (vazio = Sentry desativado; com valor, API e worker
# reportam exceções não tratadas e erros dos jobs)
SENTRY_DSN=
# Check do healthchecks.io do WORKER (dead-man switch): o worker pinga a cada
# 5 min; se o ping sumir, o healthchecks alerta (vazio = job nem é registrado)
#HEALTHCHECKS_WORKER_URL=https://hc-ping.com/SEU-UUID-WORKER
# Check do healthchecks.io do DISCO (check-disk.sh via cron): sucesso na URL,
# uso acima de 80% pinga URL/fail (padrão healthchecks)
#HEALTHCHECKS_DISK_URL=https://hc-ping.com/SEU-UUID-DISCO
# Hash da senha admin do Seq (primeira execução):
#   echo 'SuaSenha' | docker run --rm -i datalust/seq config hash
SEQ_ADMIN_PASSWORD_HASH=

# --- Demo pública (F5) -----------------------------------------------------------
# Tenant demo permanente para prospecção: o worker mantém a presença viva (60 s)
# e re-semeia todo domingo 04:30 BRT (o reseed também limpa o audit_log do demo).
# Semeie uma vez com o CLI seed-demo-tenant antes de ligar. Vazio = jobs inativos.
#DEMO_SLUG=empresa-demo
# Senha da conta viewer compartilhável (demo@...): definida aqui para permanecer
# ESTÁVEL entre reseeds (sem ela, cada reseed geraria outra senha e quebraria o
# link já enviado a prospects). Use uma senha dedicada, nunca reutilizada.
#DEMO_VIEWER_PASSWORD=
# Hostname público da demo (o DNS deve apontar para esta VPS). Default
# demo.localhost = inerte.
#DEMO_DOMAIN=demo.mais351monitor.com.br

# --- Saúde de conta para o CS (F5) ------------------------------------------------
# Telemetria INTERNA de Customer Success: toda segunda 09h BRT o worker apura as
# contas em risco (sem login há 14 dias, tenant sem eventos há 7 dias, queda de
# dispositivos com dados) e manda um e-mail com CSV importável no CRM interno.
# Vazio = o job nem é registrado. Ligue DEPOIS do início do piloto: antes disso a
# lista é vazia por definição. O tenant de DEMO_SLUG fica fora da apuração.
#CS_ALERT_EMAIL=voce@mais351monitor.com.br
